# ==============================================================================
# Variables de Entorno - PoC Instagram Graph API (Meta Facebook Graph API v26.0)
# ==============================================================================

# Token de acceso de larga duración generado en Meta for Developers
INSTAGRAM_ACCESS_TOKEN=tu_token_de_larga_duracion_aqui

# ID de la cuenta comercial de Instagram (Instagram Business Account ID)
INSTAGRAM_ACCOUNT_ID=

# Hashtag institucional para filtrar los posts (dejar vacío para traer todo)
INSTAGRAM_HASHTAG=

# Límite de publicaciones a recuperar (máximo 50 por consulta)
INSTAGRAM_LIMIT=12

# Credenciales de la aplicación en Meta for Developers (para renovación de token)
META_APP_ID=
META_APP_SECRET=
