# ==============================================================================
# Variables de Entorno - Credenciales y Secretos de Meta Graph API
# ==============================================================================
# NOTA: Los hashtags y parámetros de la web se configuran públicamente en config.js.
# Este archivo contiene ÚNICAMENTE secretos y credenciales de acceso.

# Token de acceso de larga duración (SECRETO)
INSTAGRAM_ACCESS_TOKEN=tu_token_de_larga_duracion_aqui

# ID de la cuenta comercial de Instagram (Instagram Business Account ID)
INSTAGRAM_ACCOUNT_ID=tu_account_id_aqui

# Credenciales de la aplicación en Meta for Developers (para renovación de token)
META_APP_ID=
META_APP_SECRET=
