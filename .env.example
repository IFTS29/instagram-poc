# ==============================================================================
# Variables de Entorno - PoC Instagram Graph API
# ==============================================================================

# Token de larga duración (User Access Token de 60 días)
# Se obtiene a través de Meta for Developers (ver guía adjunta)
INSTAGRAM_ACCESS_TOKEN=tu_token_de_larga_duracion_aqui

# Hashtag institucional para filtrar los posts (dejar vacío si quieres traer todos)
# Ejemplo: #IFTSEventos o #emprendimientos
INSTAGRAM_HASHTAG=#IFTSEventos

# Límite de publicaciones a recuperar (máximo 50 por consulta)
INSTAGRAM_LIMIT=12
